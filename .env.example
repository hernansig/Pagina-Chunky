# ─────────────────────────────────────────────────────────────
#  CHUNKY SNKRS — variables de entorno (PLANTILLA)
#  Copiá este archivo como `.env` y completá los valores reales.
#  El `.env` real NUNCA se sube a git (ya está en .gitignore).
#  Este archivo (.env.example) SÍ se sube: dejalo siempre con placeholders.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Dashboard Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La service_role key tiene permisos totales: SOLO se usa en el backend (Vercel Functions), nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# La anon key es pública, puede ir en el frontend (la sirve /api/app/config).
SUPABASE_ANON_KEY=eyJhbGci...

# ── Login con Google (Supabase Auth) ──────────────────────────
# El Google Client ID/Secret NO van acá: se configuran en
# Supabase Dashboard → Authentication → Providers → Google.
# En Google Cloud Console, el "Authorized redirect URI" debe ser:
#   https://<project-ref>.supabase.co/auth/v1/callback
# En Supabase → Authentication → URL Configuration, agregar como Redirect URL:
#   https://chunkysnkrs.store/auth/callback  (y http://localhost:3000/auth/callback para dev)

# ── MercadoPago (Uruguay) ─────────────────────────────────────
# Dashboard MP → Tus integraciones → Credenciales
# Las credenciales modernas usan prefijo APP_USR- (tanto producción como test).
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx
# Secreto para validar la firma (x-signature) del webhook. MP → Webhooks → tu app.
MP_WEBHOOK_SECRET=xxxxxxxx

# ── Mails (Gmail App Password + Nodemailer) ───────────────────
# Generar en: cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# A dónde llegan los avisos para el dueño (pedidos pagados, encargos, reservas).
OWNER_EMAIL=tucorreo@gmail.com

# ── Admin (login del panel) ───────────────────────────────────
ADMIN_USER=chunky
ADMIN_PASSWORD=cambia-esto-por-algo-largo-y-unico
# Secreto para firmar la cookie de sesión del admin (string aleatorio largo).
ADMIN_SESSION_SECRET=genera-un-string-aleatorio-de-64-chars
# Ruta secreta del panel (sin barra). Ej: panel-xk9wq
ADMIN_PATH=panel-xk9wq

# ── Cron ──────────────────────────────────────────────────────
# Secreto que protege los endpoints /api/cron/* (para que solo Vercel Cron o tu pinger los disparen).
CRON_SECRET=genera-otro-string-aleatorio-largo

# ── General ───────────────────────────────────────────────────
# URL pública del sitio (sin barra final). Se usa en links de mails y back_urls de MP.
SITE_URL=https://chunkysnkrs.store
# Instagram para los CTA de reserva.
INSTAGRAM_DM=https://ig.me/m/chunkysnkrs.uy
# Moneda de MercadoPago Uruguay.
CURRENCY=UYU
# Costo en puntos de cada giro de la ruleta (opcional; default 1700).
RULETA_COSTO=1700
