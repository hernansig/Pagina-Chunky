{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/pedido/:codigo", "destination": "/pedido.html" }
  ],
  "crons": [
    { "path": "/api/cron/liberar-reservas", "schedule": "0 4 * * *" },
    { "path": "/api/cron/resenas", "schedule": "0 13 * * *" }
  ]
}
